#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
display_number=${MCC_XVFB_DISPLAY_NUMBER:-$(shuf -i 100-999 -n 1)}
display=:$display_number

Xvfb "$display" -screen 0 1280x720x24 -nolisten tcp >/dev/null 2>&1 &
xvfb_pid=$!
cleanup() {
    kill "$xvfb_pid" 2>/dev/null || true
    wait "$xvfb_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

for _ in {1..100}; do
    if [[ -S /tmp/.X11-unix/X$display_number ]]; then
        DISPLAY=$display gradle -p "$root" runClient "$@"
        exit
    fi
    if ! kill -0 "$xvfb_pid" 2>/dev/null; then
        echo "Xvfb exited before display $display became ready" >&2
        exit 1
    fi
    sleep 0.05
done

echo "Xvfb display $display did not become ready" >&2
exit 1
